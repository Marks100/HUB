{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks":
     [
        {
            "label": "flash_with_jlink",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "JFlash.exe -openprj\"${workspaceFolder}/Tool_cfg/Jflash/jflash_proj.jflash\" -open\"./Build/SUPER_PILL/APP_signed.hex\" -auto -min -exit",
        },
        {
            "label": "all",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe all",
        },
        {
            "label": "APP_build",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe app_build",
            "group": { "kind": "build", "isDefault": true },
        },
        {
            "label": "variant_super_pill",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe variant_super_pill",
        },
        {
            "label": "variant_blue_pill",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe variant_blue_pill",
        },
        {
            "label": "dataset",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe dataset",
        },
        {
            "label": "APP_rebuild",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe app_rebuild",
        },
        {
            "label": "BM_build",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/BM" },
            "command": "mingw32-make.exe bm_build",
        },
        {
            "label": "BM_rebuild",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/BM" },
            "command": "mingw32-make.exe bm_rebuild",
        },
        {
            "label": "FBL_build",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/FBL" },
            "command": "mingw32-make.exe fbl_build",
        },
        {
            "label": "FBL_rebuild",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/FBL" },
            "command": "mingw32-make.exe fbl_rebuild",
        },
        {
            "label": "total_clean",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe total_clean",
        },
        {
            "label": "test_specific",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe ${fileBasenameNoExtension}.test",
            "group": { "kind": "test", "isDefault": true },
        },
        {
            "label": "test_unit_all",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe test_unit_all",
        },
        {
            "label": "test_sw_all",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe test_sw_all",
        },
        {
            "label": "test_all",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe test_unit_all test_sw_all",
        },
        {
            "label": "sw_test_lib_build",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP/test/build_system" },
            "command": "mingw32-make.exe -j8",
        },
        {
            "label": "sw_test_lib_clean",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP/test/build_system" },
            "command": "mingw32-make.exe clean",
        },
        {
            "label": "gen_overall_gcovr_report",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe gen_lcov_report",
        },
        {
            "label": "APP_memory_stats",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe memory_stats",
        },
        {
            "label": "APP_object_stats",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe object_stats",
        },
        {
            "label": "BM_memory_stats",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/BM" },
            "command": "mingw32-make.exe memory_stats",
        },
        {
            "label": "FBL_memory_stats",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/FBL" },
            "command": "mingw32-make.exe memory_stats",
        },
        {
            "label": "release_package",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe release_package",
        },
        {
            "label": "doxygen",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe doxygen",
        },
        {
            "label": "analyse_app_mapfile",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/APP" },
            "command": "mingw32-make.exe analyse_app_mapfile",
        },
        {
            "label": "trace32",
            "type": "process",
            "command": "bash",
            "args": ["scripts/trace32"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PTLD": "${workspaceFolder}" }
            },
            "isBackground": true,
        },
    ]
}