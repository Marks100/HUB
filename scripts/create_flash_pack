#!/usr/bin/env ruby

#===================================================================================
# Create Flash Pack
#===================================================================================
# Purpose: Bundle a flash profile, an optional security DLL/plugin, and one or more
#          firmware files into a single .flashpack ZIP archive that the CAN_FLASH
#          tool (see its src/flash_pack.py) can import directly.
#
# Pack layout (must match CAN_FLASH/src/flash_pack.py's load_pack()/create_pack()
# exactly - this script writes the same archive shape from the build side that tool
# reads from the GUI side):
#
#   profile.json           - copy of <profile>, optionally with "sw_version" added
#   security/<name>        - optional, at most one file - .dll or .py
#   firmware/<name>        - one or more firmware files (.hex/.s19/.mot/...)
#
# No 'zip'/'rubyzip' gem is vendored in BuildEnv/xBuildEnv/lib (only digest-crc is,
# for app_crc_injector) and Ruby's standard library has no ZIP archive support, only
# raw deflate (Zlib::Deflate). Rather than add a new external gem dependency to this
# project's hermetic build tooling, this writes the ZIP container format directly
# using STORED (uncompressed) entries - simple enough to get exactly right without
# needing to hand-roll a compressor, and Python's zipfile module (what flash_pack.py
# reads with) supports STORED entries natively, no compression required on either
# side for this to round-trip correctly.
#===================================================================================

require 'docopt'
require 'json'
require 'zlib'

DOC = <<~DOCOPT
  Create Flash Pack

  Bundle a flash profile, optional security DLL/plugin, and firmware file(s)
  into a single .flashpack archive for the CAN_FLASH tool.

  Usage:
    #{File.basename(__FILE__)} <profile> <firmware>... --output=PATH [options]
    #{File.basename(__FILE__)} -h | --help
    #{File.basename(__FILE__)} --version

  Arguments:
    <profile>             Flash profile JSON file
    <firmware>             One or more firmware files (.hex, .s19, .mot, ...)

  Options:
    --output PATH          Output .flashpack file path (required)
    --security PATH        Optional seed/key DLL (.dll) or Python plugin (.py) to bundle
    --sw-version VERSION   Optional firmware version, stamped into profile.json as "sw_version"
    -h --help              Show this help message
    --version              Show version

  Examples:
    #{File.basename(__FILE__)} hub_bootloader.json APP_signed.hex --output=APP_v1.2.3.flashpack
    #{File.basename(__FILE__)} hub_bootloader.json APP_signed.hex --output=APP_v1.2.3.flashpack --security=hub_bootloader_xor.py --sw-version=1.2.3
DOCOPT

VERSION = '1.0.0'

#===================================================================================
# Minimal ZIP writer - STORED (uncompressed) entries only, see file header comment
#===================================================================================
class ZipWriter
  LOCAL_FILE_HEADER_SIG     = 0x04034b50
  CENTRAL_DIRECTORY_SIG     = 0x02014b50
  END_OF_CENTRAL_DIR_SIG    = 0x06054b50
  VERSION_NEEDED            = 20   # 2.0 - stored entries, no zip64, no encryption
  METHOD_STORED             = 0

  Entry = Struct.new(:name, :crc32, :size, :offset)

  def initialize(output_path)
    @output_path = output_path
    @entries     = []
  end

  # Adds one file's bytes into the archive under `arc_name` (the path shown inside
  # the zip, e.g. "profile.json" or "firmware/APP.hex").
  def add(arc_name, data)
    @entries << [arc_name, data]
  end

  def write
    dos_time, dos_date = dos_timestamp

    File.open(@output_path, 'wb') do |f|
      written_entries = []

      @entries.each do |arc_name, data|
        offset = f.pos
        crc    = Zlib.crc32(data)
        size   = data.bytesize
        name_b = arc_name.b

        f.write([
          LOCAL_FILE_HEADER_SIG, VERSION_NEEDED, 0, METHOD_STORED,
          dos_time, dos_date, crc, size, size, name_b.bytesize, 0
        ].pack('VvvvvvVVVvv'))
        f.write(name_b)
        f.write(data)

        written_entries << Entry.new(name_b, crc, size, offset)
      end

      central_dir_offset = f.pos

      written_entries.each do |e|
        f.write([
          CENTRAL_DIRECTORY_SIG, VERSION_NEEDED, VERSION_NEEDED, 0, METHOD_STORED,
          dos_time, dos_date, e.crc32, e.size, e.size,
          e.name.bytesize, 0, 0, 0, 0, 0, e.offset
        ].pack('VvvvvvvVVVvvvvvVV'))
        f.write(e.name)
      end

      central_dir_size = f.pos - central_dir_offset

      f.write([
        END_OF_CENTRAL_DIR_SIG, 0, 0,
        written_entries.length, written_entries.length,
        central_dir_size, central_dir_offset, 0
      ].pack('VvvvvVVv'))
    end
  end

  private

  # MS-DOS date/time format used by the ZIP spec - good enough for a build artefact's
  # timestamp, nothing reads this for correctness (Python's zipfile only cares about
  # it for display, not for extraction).
  def dos_timestamp
    now = Time.now
    time = (now.hour << 11) | (now.min << 5) | (now.sec / 2)
    date = ((now.year - 1980) << 9) | (now.month << 5) | now.day
    [time, date]
  end
end

#===================================================================================
# Main processing
#===================================================================================
def build_pack(options)
  profile_path  = options['<profile>']
  firmware_list = options['<firmware>']
  output_path   = options['--output']
  security_path = options['--security']
  sw_version    = options['--sw-version']

  raise "Profile not found: #{profile_path}" unless File.file?(profile_path)
  firmware_list.each do |fw|
    raise "Firmware file not found: #{fw}" unless File.file?(fw)
  end
  if security_path && !File.file?(security_path)
    raise "Security file not found: #{security_path}"
  end

  output_path += '.flashpack' unless output_path.downcase.end_with?('.flashpack')
  FileUtils_mkdir_p(File.dirname(output_path))

  zip = ZipWriter.new(output_path)

  profile_json = JSON.parse(File.read(profile_path))
  profile_json['sw_version'] = sw_version if sw_version
  zip.add('profile.json', JSON.pretty_generate(profile_json))

  if security_path
    zip.add("security/#{File.basename(security_path)}", File.binread(security_path))
  end

  firmware_list.each do |fw|
    zip.add("firmware/#{File.basename(fw)}", File.binread(fw))
  end

  zip.write

  puts "Flash pack created: #{output_path}"
  puts "  Profile:  #{File.basename(profile_path)}"
  puts "  Security: #{security_path ? File.basename(security_path) : '(none)'}"
  puts "  Firmware: #{firmware_list.map { |f| File.basename(f) }.join(', ')}"
  puts "  SW version: #{sw_version}" if sw_version
end

# Tiny stand-in for FileUtils.mkdir_p so this script needs no extra require beyond
# stdlib already pulled in above - avoids requiring 'fileutils' for one call site.
def FileUtils_mkdir_p(dir)
  return if dir.empty? || Dir.exist?(dir)
  require 'fileutils'
  FileUtils.mkdir_p(dir)
end

#===================================================================================
# Entry point
#===================================================================================
if __FILE__ == $0
  begin
    options = Docopt::docopt(DOC, version: VERSION)
    build_pack(options)
    exit(0)
  rescue Docopt::Exit => e
    puts e.message
    exit(e.message.start_with?('Usage:') ? 1 : 0)
  rescue => e
    STDERR.puts "FATAL ERROR: #{e.message}"
    exit(1)
  end
end
