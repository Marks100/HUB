#!/bin/bash

# Export ELF and combined HEX paths as Windows paths for Trace32.
# Exact file names, not find patterns: a pattern like "*combined*.hex" also matched saved copies
# such as BM_FBL_APP_combined_baseline_10makes.hex, the variable then held two paths, and Trace32
# flashed whichever one find happened to list first.
#
# Every hardware variant builds into its own Build/<VARIANT>: SUPER_PILL unless HW_VARIANT says BLUE_PILL.
VARIANT=${HW_VARIANT:-SUPER_PILL}
APP_ELF=$PTLD/APP/Build/$VARIANT/APP.elf
BM_ELF=$PTLD/BM/Build/$VARIANT/BM.elf
FBL_ELF=$PTLD/FBL/Build/$VARIANT/FBL.elf
COMBINED_HEX=$PTLD/APP/Build/$VARIANT/BM_FBL_APP_combined.hex

for f in "$APP_ELF" "$BM_ELF" "$FBL_ELF" "$COMBINED_HEX"; do
    if [ ! -f "$f" ]; then
        echo "trace32: missing $f - build it first (make all in APP, or make variant_<name>)" >&2
        exit 1
    fi
done

export LAUTERBACH_APP_EXE=$(cygpath -w "$APP_ELF")
export LAUTERBACH_BM_EXE=$(cygpath -w "$BM_ELF")
export LAUTERBACH_FBL_EXE=$(cygpath -w "$FBL_ELF")
export LAUTERBACH_COMBINED_EXE=$(cygpath -w "$COMBINED_HEX")

# Launch Trace32 for ARM Cortex-M3 (STM32)
cd $PTLD/Tool_cfg/Lauterbach && t32marm -c $PTLD/Tool_cfg/Lauterbach/config.t32 -s $PTLD/Tool_cfg/Lauterbach/stm32f103_attach.cmm &
